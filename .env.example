# Anthropic (Claude) - Admin API Key
# Get from: https://console.anthropic.com/settings/admin-keys
ANTHROPIC_ADMIN_API_KEY=
ANTHROPIC_ORGANIZATION_ID=

# OpenAI (ChatGPT) - Admin API Key
# Get from: https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_API_KEY=
OPENAI_ORGANIZATION_ID=

# Google Gemini - Service Account Credentials
# Get from: Google Cloud Console > IAM > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_BILLING_ACCOUNT_ID=

# Higgsfield API
# Get from: Higgsfield dashboard
HIGGSFIELD_API_KEY=

# Weavy API
# Get from: Weavy dashboard > API keys
WEAVY_API_KEY=
WEAVY_ENVIRONMENT_URL=

# Server
PORT=3001
